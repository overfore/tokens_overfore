olor=#F3F7FB;strokeColor=#24456F;strokeWidth=1.5;fontColor=#333E4C;fontFamily=Arial;fontSize=15;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=42;" vertex="1" parent="1"><mxGeometry x="0" y="110" width="190" height="120" as="geometry"/></mxCell><mxCell id="f11-14" value="Oficina de calidad" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#0B2343;strokeColor=#0B2343;strokeWidth=1;fontColor=#FFFFFF;fontFamily=Arial;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=5;spacingRight=5;" vertex="1" parent="1"><mxGeometry x="0" y="110" width="190" height="36" as="geometry"/></mxCell><mxCell id="f11-15" value="Responsable independiente; SGSI ISO/IEC 27001" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F3F7FB;strokeColor=#24456F;strokeWidth=1.5;fontColor=#333E4C;fontFamily=Arial;fontSize=15;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=60;" vertex="1" parent="1"><mxGeometry x="470" y="110" width="190" height="120" as="geometry"/></mxCell><mxCell id="f11-16" value="Seguridad de la información" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#0B2343;strokeColor=#0B2343;strokeWidth=1;fontColor=#FFFFFF;fontFamily=Arial;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=5;spacingRight=5;" vertex="1" parent="1"><mxGeometry x="470" y="110" width="190" height="54" as="geometry"/></mxCell><mxCell id="f11-22" value="Casa matriz, Santiago. Desarrollo, pruebas y datos de las cuatro plataformas en operación. Asigna a Aranda 8 desarrolladores (7 desde el mes 13), 1 analista de pruebas y 1 a 2 analistas de datos." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F3F7FB;strokeColor=#24456F;strokeWidth=1.5;fontColor=#333E4C;fontFamily=Arial;fontSize=15;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=42;" vertex="1" parent="1"><mxGeometry x="0" y="290" width="212" height="205" as="geometry"/></mxCell><mxCell id="f11-23" value="Área de desarrollo" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#0B2343;strokeColor=#0B2343;strokeWidth=1;fontColor=#FFFFFF;fontFamily=Arial;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=5;spacingRight=5;" vertex="1" parent="1"><mxGeometry x="0" y="290" width="212" height="36" as="geometry"/></mxCell><mxCell id="f11-26" value="Casa matriz, Santiago. Mesa de ayuda, NOC y SOC 24x7, y soporte de segundo nivel. Asigna a Aranda 10 analistas de operación y 5 de seguridad." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F3F7FB;strokeColor=#24456F;strokeWidth=1.5;fontColor=#333E4C;fontFamily=Arial;fontSize=15;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=42;" vertex="1" parent="1"><mxGeometry x="224" y="290" width="212" height="205" as="geometry"/></mxCell><mxCell id="f11-27" value="Centro de operaciones" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#0B2343;strokeColor=#0B2343;strokeWidth=1;fontColor=#FFFFFF;fontFamily=Arial;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=5;spacingRight=5;" vertex="1" parent="1"><mxGeometry x="224" y="290" width="212" height="36" as="geometry"/></mxCell><mxCell id="f11-30" value="Antofagasta. Técnicos de terreno en turnos 7x7, acreditados para faena. Asigna a Aranda hasta 10 técnicos de terreno, 5 desde el mes 24." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F3F7FB;strokeColor=#24456F;strokeWidth=1.5;fontColor=#333E4C;fontFamily=Arial;fontSize=15;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=42;" vertex="1" parent="1"><mxGeometry x="448" y="290" width="212" height="205" as="geometry"/></mxCell><mxCell id="f11-31" value="Base zona norte" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#0B2343;strokeColor=#0B2343;strokeWidth=1;fontColor=#FFFFFF;fontFamily=Arial;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=5;spacingRight=5;" vertex="1" parent="1"><mxGeometry x="448" y=